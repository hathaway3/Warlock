<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Warlock - Error</title>
	<style>
		body {
			margin: 0;
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			background: #07090e;
			color: #fff;
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		}
		.card {
			max-width: 420px;
			width: 100%;
			margin: 16px;
			padding: 32px;
			border-radius: 16px;
			background: #0d121f;
			border: 1px solid rgba(255, 255, 255, 0.1);
			text-align: center;
			box-sizing: border-box;
		}
		h1 {
			font-size: 18px;
			margin: 0 0 4px;
		}
		.tagline {
			color: #94a3b8;
			font-size: 13px;
			margin: 0 0 16px;
		}
		.message {
			background: rgba(244, 63, 94, 0.1);
			border: 1px solid rgba(244, 63, 94, 0.3);
			color: #fca5a5;
			border-radius: 12px;
			padding: 12px;
			font-size: 12px;
			font-family: ui-monospace, monospace;
			word-break: break-word;
		}
		a.button {
			display: inline-block;
			margin-top: 20px;
			padding: 10px 20px;
			border-radius: 12px;
			background: #4f46e5;
			color: #fff;
			text-decoration: none;
			font-size: 13px;
			font-weight: 600;
		}
		a.button:hover {
			background: #4338ca;
		}
	</style>
</head>
<body>
	<div class="card">
		<h1><%= error.title || 'Something went wrong' %></h1>
		<p class="tagline"><%= tagLine %></p>
		<div class="message"><%= error.message %></div>
		<a class="button" href="/">Return to Warlock</a>
	</div>
</body>
</html>
